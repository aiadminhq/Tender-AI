{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx -y pnpm@10.33.0 --dir tender-ai-frontend install --frozen-lockfile",
  "buildCommand": "npx -y pnpm@10.33.0 --dir tender-ai-frontend run build",
  "outputDirectory": "tender-ai-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# ============================================================
# Tender AI Frontend — 環境變數範本（Vite build-time）
# 複製成 .env 或設定到 Vercel Dashboard → Settings → Environment Variables
# ============================================================

# FastAPI 後端 API base URL（Railway 部署後填入實際網址）
VITE_API_BASE=https://your-backend.railway.app/api/v1

# 與後端 APP_API_KEY 相同的值（可留空讓後端不啟用保護）
VITE_API_KEY=

# "false" = 純 mock 模式（不呼叫後端）；正式環境設 "true"
VITE_USE_API=true

# "false" = 停用事件追蹤
VITE_TRACK=true

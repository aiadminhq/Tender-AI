{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE": "https://tender-ai-production-05e8.up.railway.app/api/v1",
    "VITE_API_KEY": "4e091223-31e3-4e7a-9e64-ad85c0e901ac",
    "VITE_USE_API": "true",
    "VITE_TRACK": "true"
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|svg|webp|woff2?))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

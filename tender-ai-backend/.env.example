# ============================================================
# Tender AI Backend — 環境變數範本
# 複製成 .env 後填入真實值（.env 已 gitignore，絕不入版控）
# ============================================================

# --- 資料庫（Supabase）---
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# 把 "postgres://" 改成 "postgresql+psycopg://"（psycopg3 driver 前綴）
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- AI：Embeddings（本機 Ollama）---
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# --- AI：聊天助手 provider ---
# ASSISTANT_USE_LLM=false          → 停用生成，退回模板（最保守，無 API key 時適用）
# ASSISTANT_USE_LLM=true
#   + ASSISTANT_PROVIDER=ollama    → 本機 Ollama（預設）
#   + ASSISTANT_PROVIDER=claude    → Anthropic Claude API（Railway 正式環境推薦）
ASSISTANT_USE_LLM=true
ASSISTANT_PROVIDER=claude

# --- AI：Anthropic API（ASSISTANT_PROVIDER=claude 或 P5 推理用）---
# 之後補上：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude 模型（選填，預設 claude-haiku-4-5-20251001）
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- OpenRouter（ASSISTANT_PROVIDER=openrouter 時使用）---
# 取得 key：https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Tender-AI

# --- 後端 API 保護金鑰 ---
# 前端 VITE_API_KEY 須與此相同
# 產生：openssl rand -hex 32
APP_API_KEY=

# --- CORS（前端來源白名單，逗號分隔）---
# 本機：http://localhost:5173
# 正式：https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 爬蟲路徑（僅本機 / 公司伺服器需要）---
PCC_SCRAPER_PATH=../tender-bot/tender_daily.py

# ============================================================
# Tender AI Backend — 環境變數範本
# 複製成 .env 後填入真實值（.env 已 gitignore，絕不入版控）
# ============================================================

# --- 資料庫（Supabase）---
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# 把 "postgres://" 改成 "postgresql+psycopg://"（psycopg3 driver 前綴）
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- AI：Embeddings + Chat（本機 Ollama）---
# Railway 上 Ollama 不可用 → 設 ASSISTANT_USE_LLM=false 可停用 chat 生成
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
ASSISTANT_USE_LLM=true

# --- AI：高品質推理（Anthropic）---
# 正式環境請填入；本機開發可留空（P5 功能停用）
ANTHROPIC_API_KEY=

# --- 後端 API 保護金鑰 ---
# 前端 VITE_API_KEY 須與此相同
# 產生：openssl rand -hex 32
APP_API_KEY=

# --- CORS（前端來源白名單，逗號分隔）---
# 本機：http://localhost:5173
# 正式：https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 爬蟲路徑（僅本機 / 公司伺服器需要）---
PCC_SCRAPER_PATH=../tender-bot/tender_daily.py
